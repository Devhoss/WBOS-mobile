{
  "name": "wbos-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "expo start -c"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "better-auth": "^1.2.12",
    "clsx": "^2.1.1",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^3.2.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "^5.1.0",
    "react-native-vision-camera-barcode-scanner": "^5.1.0",
    "react-native-web": "~0.21.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.1",
    "zustand": "^5.0.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["react-native-nitro-image"]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    },
    "install": {
      "exclude": ["react-native-vision-camera", "react-native-vision-camera-barcode-scanner"]
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0"
  }
